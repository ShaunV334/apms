rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isLegacyDefault(uid) {
      return uid == "default";
    }

    function isCurrentUserOrLegacy(uid) {
      return isCurrentUser(uid) || (isSignedIn() && isLegacyDefault(uid));
    }

    function hasOnlyKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    function hasVitalShape() {
      return hasOnlyKeys(["heartRate", "spo2", "timestamp"]) &&
        request.resource.data.heartRate is int &&
        request.resource.data.spo2 is int;
    }

    function hasFallShape() {
      return hasOnlyKeys(["timestamp", "fall"]) || hasOnlyKeys(["timestamp"]);
    }

    function hasLocationShape() {
      return request.resource.data.keys().hasOnly([
        "latitude",
        "longitude",
        "hdop",
        "satellites",
        "timestamp"
      ]) &&
      request.resource.data.latitude is number &&
      request.resource.data.longitude is number;
    }

    match /users/{userId} {
      allow read: if isCurrentUserOrLegacy(userId);
      allow create, update, delete: if isCurrentUser(userId);

      match /medicines/{medicineId} {
        allow read, create, update, delete: if isCurrentUserOrLegacy(userId);
      }

      match /locations/{locationId} {
        allow read: if isCurrentUserOrLegacy(userId);
        allow create: if hasLocationShape();
        allow update, delete: if false;
      }
    }

    match /medicines/{medicineId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /medicineLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /vitals/{readingId} {
      allow read: if isSignedIn();
      allow create: if hasVitalShape();
      allow update, delete: if false;
    }

    match /falls/{fallId} {
      allow read: if isSignedIn();
      allow create: if hasFallShape();
      allow update, delete: if false;
    }

    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow create: if hasLocationShape();
      allow update, delete: if false;
    }

    match /voiceMessages/{messageId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }
  }
}